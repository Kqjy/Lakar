{
  "name": "lakar",
  "private": true,
  "version": "1.0.5",
  "description": "Lakar — a hand-drawn whiteboard with end-to-end encrypted cloud sync",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "invite": "npm run invite --workspace server --",
    "test": "node --import ./client/test/resolve-ts.mjs --test client/src/**/*.test.ts server/*.test.js"
  }
}
